              name="Margin Intelligence"
              web_icon="smart_product_margin_alert,static/description/icon.png"
              sequence="20"
              groups="smart_product_margin_alert.group_margin_user"/>

    <!-- Dashboard -->
    <menuitem id="menu_smart_margin_dashboard"
              name="Dashboard"
              parent="menu_smart_product_margin_root"
              action="action_product_margin_intelligence_dashboard"
              sequence="10"
