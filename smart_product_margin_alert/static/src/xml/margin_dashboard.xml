<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="smart_product_margin_alert.ProductMarginDashboard" owl="1">
        <div class="o_smart_margin_dashboard p-4 min-vh-100">

            <!-- A. HEADER -->
            <div class="dashboard-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon shadow-sm">
                        <i class="fa fa-line-chart"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="header-title mb-0">Product Margin Intelligence</h2>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small fw-bold">Commercial Edition</span>
                        </div>
                        <p class="header-subtitle mb-0 mt-1">Real-time profitability tracking, automated compliance alerts &amp; loss prevention</p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Status Filter Group -->
                    <div class="btn-group filter-btn-group" role="group">
                        <button type="button"
                                t-attf-class="btn btn-sm #{ state.filterStatus === 'all' ? 'active' : 'btn-outline-secondary' }"
                                t-on-click="() => this.setFilter('all')">
                            All Catalog
                        </button>
                        <button type="button"
                                t-attf-class="btn btn-sm #{ state.filterStatus === 'healthy' ? 'active' : 'btn-outline-secondary' }"
                                t-on-click="() => this.setFilter('healthy')">
                            Healthy
                        </button>
                        <button type="button"
                                t-attf-class="btn btn-sm #{ state.filterStatus === 'low' ? 'active' : 'btn-outline-secondary' }"
                                t-on-click="() => this.setFilter('low')">
                            Low Margin
                        </button>
                        <button type="button"
                                t-attf-class="btn btn-sm #{ state.filterStatus === 'negative' ? 'active' : 'btn-outline-secondary' }"
                                t-on-click="() => this.setFilter('negative')">
                            Loss-Making
                        </button>
                    </div>

                    <!-- Action Navigation -->
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="refreshDashboard" title="Refresh Live Data">
                        <i class="fa fa-refresh me-1"></i> Refresh
                    </button>
                    <button class="btn btn-outline-primary btn-sm" t-on-click="() => this.openMarginMonitor()" title="Open Product Margin Monitor List">
                        <i class="fa fa-th-list me-1"></i> Margin Monitor
                    </button>
                    <button class="btn btn-outline-danger btn-sm" t-on-click="() => this.openSalesOrders()" title="Review Orders with Margin Alerts">
                        <i class="fa fa-shopping-cart me-1"></i> Sales Orders
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="openSettings" title="Configure Margin Thresholds">
                        <i class="fa fa-cog"></i>
                    </button>
                </div>
            </div>

            <!-- Loading Spinner State -->
            <t t-if="state.loading">
                <div class="text-center py-5 my-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3 text-muted fw-semibold">Analyzing product margins &amp; sales compliance...</p>
                </div>
            </t>

            <t t-else="">
                <!-- B. FIVE KPI CARDS -->
                <div class="row g-3 mb-4">

                    <!-- 1. Total Monitored Products -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card" t-on-click="() => this.openMarginMonitor()">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="kpi-label">Monitored Products</span>
                                    <div class="kpi-icon-wrap icon-primary">
                                        <i class="fa fa-cubes"></i>
                                    </div>
                                </div>
                                <div class="kpi-value mb-2">
                                    <t t-esc="state.data.kpi.total_monitored"/>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="kpi-comparison comp-primary">
                                    <i class="fa fa-database me-1"></i> Active Catalog
                                </span>
                                <span class="text-muted small">View all &#8594;</span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Healthy Margin Products -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card" t-on-click="() => this.openMarginMonitor([['margin_status', '=', 'healthy']])">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="kpi-label">Healthy Margin</span>
                                    <div class="kpi-icon-wrap icon-success">
                                        <i class="fa fa-check-circle"></i>
                                    </div>
                                </div>
                                <div class="kpi-value text-success mb-2">
                                    <t t-esc="state.data.kpi.healthy_count"/>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="kpi-comparison comp-success">
                                    <i class="fa fa-arrow-up me-1"></i> <t t-esc="state.data.kpi.healthy_pct"/>% of catalog
                                </span>
                                <span class="text-muted small">&#8805; Target</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Low Margin Products -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card" t-on-click="() => this.openMarginMonitor([['margin_status', '=', 'low']])">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="kpi-label">Low Margin Alert</span>
                                    <div class="kpi-icon-wrap icon-warning">
                                        <i class="fa fa-exclamation-triangle"></i>
                                    </div>
                                </div>
                                <div class="kpi-value text-warning mb-2">
                                    <t t-esc="state.data.kpi.low_count"/>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="kpi-comparison comp-warning">
                                    <i class="fa fa-bell me-1"></i> <t t-esc="state.data.kpi.low_pct"/>% needs review
                                </span>
                                <span class="text-muted small">&lt; Target</span>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Loss-Making Products -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card" t-on-click="() => this.openMarginMonitor([['margin_status', '=', 'negative']])">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="kpi-label">Loss-Making</span>
                                    <div class="kpi-icon-wrap icon-danger">
                                        <i class="fa fa-times-circle"></i>
                                    </div>
                                </div>
                                <div class="kpi-value text-danger mb-2">
                                    <t t-esc="state.data.kpi.negative_count"/>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="kpi-comparison comp-danger">
                                    <i class="fa fa-exclamation me-1"></i> <t t-esc="state.data.kpi.negative_pct"/>% below cost
                                </span>
                                <span class="text-danger fw-bold small">Critical</span>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Average Profit Margin -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card" t-on-click="() => this.openMarginMonitor()">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="kpi-label">Avg Profit Margin</span>
                                    <div class="kpi-icon-wrap icon-primary">
                                        <i class="fa fa-percent"></i>
                                    </div>
                                </div>
                                <div class="kpi-value mb-2 text-primary">
                                    <t t-esc="state.data.kpi.avg_margin_percent"/>%
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span t-attf-class="kpi-comparison #{ state.data.kpi.avg_margin_diff >= 0 ? 'comp-success' : 'comp-danger' }">
                                    <t t-if="state.data.kpi.avg_margin_diff >= 0">+</t><t t-esc="state.data.kpi.avg_margin_diff"/>% vs target
                                </span>
                                <span class="text-muted small">Target: <t t-esc="state.data.kpi.default_min_margin"/>%</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- C. PROFESSIONAL VISUALIZATIONS (2x2 Grid) -->
                <div class="row g-3 mb-4">

                    <!-- Chart 1: Margin Distribution -->
                    <div class="col-12 col-lg-6">
                        <div class="chart-card">
                            <div class="chart-header">
                                <h3 class="chart-title">
                                    <i class="fa fa-bar-chart me-2 text-primary"></i>Margin Distribution
                                </h3>
                                <span class="chart-badge">Catalog Segmentation</span>
                            </div>
                            <div class="chart-body">
                                <canvas t-ref="distCanvas"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 2: Products by Margin Status -->
                    <div class="col-12 col-lg-6">
                        <div class="chart-card">
                            <div class="chart-header">
                                <h3 class="chart-title">
                                    <i class="fa fa-pie-chart me-2 text-primary"></i>Products by Margin Status
                                </h3>
                                <span class="chart-badge">Compliance Ratio</span>
                            </div>
                            <div class="chart-body">
                                <canvas t-ref="statusCanvas"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 3: Top 10 Most Profitable Products -->
                    <div class="col-12 col-lg-6">
                        <div class="chart-card">
                            <div class="chart-header">
                                <h3 class="chart-title">
                                    <i class="fa fa-trophy me-2 text-primary"></i>Top 10 Most Profitable Products
                                </h3>
                                <span class="chart-badge">Unit Profit (<t t-esc="state.data.currency_symbol"/>)</span>
                            </div>
                            <div class="chart-body">
                                <canvas t-ref="profitCanvas"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 4: Top 10 Lowest Margin Products -->
                    <div class="col-12 col-lg-6">
                        <div class="chart-card">
                            <div class="chart-header">
                                <h3 class="chart-title">
                                    <i class="fa fa-warning me-2 text-warning"></i>Top 10 Lowest Margin Products
                                </h3>
                                <span class="chart-badge text-danger">Immediate Risk</span>
                            </div>
                            <div class="chart-body">
                                <canvas t-ref="lowestCanvas"></canvas>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- D. MARGIN ALERTS SECTION -->
                <div class="alerts-card">
                    <div class="alerts-header">
                        <div>
                            <h3 class="alerts-title">
                                <i class="fa fa-shield me-2 text-primary"></i>Margin Alerts
                            </h3>
                            <p class="alerts-caption">Products currently requiring executive attention due to margin deficits or selling below cost.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-semibold">
                                <t t-esc="state.data.alerts.length"/> Products at Risk
                            </span>
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.openMarginMonitor([['margin_status', 'in', ['low', 'negative']]])">
                                View in Monitor &#8594;
                            </button>
                        </div>
                    </div>

                    <!-- Alerts Table -->
                    <t t-if="state.data.alerts.length > 0">
                        <div class="table-responsive">
                            <table class="table alerts-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Product Name</th>
                                        <th class="text-end">Cost Price</th>
                                        <th class="text-end">Sales Price</th>
                                        <th class="text-end">Current Margin</th>
                                        <th class="text-end">Minimum Target</th>
                                        <th class="text-center">Risk Status</th>
                                        <th class="text-center">Alert Mode</th>
                                        <th class="text-end">Quick Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.alerts" t-as="alert" t-key="alert.id">
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="me-2">
                                                        <i t-attf-class="fa #{ alert.status === 'negative' ? 'fa-times-circle text-danger' : 'fa-exclamation-triangle text-warning' }"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark"><t t-esc="alert.name"/></div>
                                                        <t t-if="alert.code">
                                                            <div class="text-muted small"><t t-esc="alert.code"/></div>
                                                        </t>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end text-muted font-monospace">
                                                <t t-esc="formatCurrency(alert.cost)"/>
                                            </td>
                                            <td class="text-end fw-semibold font-monospace">
                                                <t t-esc="formatCurrency(alert.price)"/>
                                            </td>
                                            <td class="text-end font-monospace">
                                                <span t-attf-class="fw-bold #{ alert.status === 'negative' ? 'text-danger' : 'text-warning' }">
                                                    <t t-esc="alert.margin_percent"/>%
                                                </span>
                                            </td>
                                            <td class="text-end text-muted font-monospace">
                                                <t t-esc="alert.min_margin_percent"/>%
                                            </td>
                                            <td class="text-center">
                                                <span t-attf-class="badge-status status-#{ alert.status }">
                                                    <i t-attf-class="fa #{ alert.status === 'negative' ? 'fa-ban' : 'fa-exclamation' }"></i>
                                                    <t t-esc="alert.status_label"/>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span t-attf-class="badge-mode mode-#{ alert.alert_mode }">
                                                    <t t-esc="alert.alert_mode_label"/>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-outline-primary btn-sm rounded-2"
                                                        t-on-click="() => this.openProduct(alert.id)"
                                                        title="Open product pricing &amp; margin intelligence">
                                                    <i class="fa fa-external-link me-1"></i> Inspect
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- Empty State (No Alerts) -->
                    <t t-else="">
                        <div class="empty-state">
                            <div class="empty-icon shadow-sm">
                                <i class="fa fa-check"></i>
                            </div>
                            <h4 class="empty-title">All Products Satisfy Profitability Standards</h4>
                            <p class="empty-desc">
                                No products in the current selection fall below minimum margin requirements or operate at negative margins.
                            </p>
                        </div>
                    </t>
                </div>

            </t>

        </div>
    </t>
</templates>
